# Copy to .env and fill in. Paths are relative to the project folder.

# Language model: either an AI Studio key, or a Vertex AI service account (preferred when set).
GEMINI_API_KEY=
VERTEX_CREDENTIALS=
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Video clips (Vertex AI only). The price is used for the estimate shown before generating.
VIDEO_MODEL=veo-3.1-fast-generate-001
VIDEO_LOCATION=us-central1
VIDEO_PRICE_PER_SECOND=0.15

# YouTube: public pages (no quota, rounded numbers) or api (exact numbers, uses quota).
YOUTUBE_SOURCE=public
YOUTUBE_API_KEY=
# OAuth Desktop client used to connect channels (analytics). Default shown.
YOUTUBE_OAUTH_CLIENT=credentials/youtube_oauth_client.json
YOUTUBE_QUOTA_PER_DAY=10000
# Optional cookies.txt for caption downloads when YouTube rate-limits anonymous requests.
YOUTUBE_COOKIES_FILE=

# Server
NICHESCOPE_HOST=127.0.0.1
NICHESCOPE_PORT=8765
NICHESCOPE_DATA_DIR=data
